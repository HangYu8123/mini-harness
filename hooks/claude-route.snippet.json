{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/.harness/hooks/route.sh\"", "timeout": 5, "statusMessage": "mini-harness" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/.harness/hooks/route.sh\"", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task",
        "hooks": [ { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/.harness/hooks/route.sh\"", "timeout": 5 } ] }
    ]
  }
}
